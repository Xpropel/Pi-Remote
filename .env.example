# pi-remote 本机配置模板（Windows / macOS / Linux 通用）。
# 用法：node deploy/setup.cjs            （自动从 relay/config.json 或环境变量填入 token 生成本文件）
#       node deploy/setup.cjs ws://<云服务器IP>:7001   （同时指定 relay 地址）
# 本文件会被启动脚本读取并注入 pi 进程环境变量：Windows 是 deploy\start-pi.cmd，macOS / Linux 是 deploy/start-pi.sh。
# relay 跑在云服务器上；本机 pi 只作为客户端连这个地址。

# 云服务器 relay 的 local 通道地址（本地测试时用 ws://127.0.0.1:7001）
PI_REMOTE_RELAY=ws://127.0.0.1:7001

# 与 relay 的 localToken 一致（setup.cjs 从 PI_REMOTE_LOCAL_TOKEN 或 relay/config.json 自动填）
PI_REMOTE_TOKEN=change-me

# 可选：本机在房间列表里的显示名
PI_REMOTE_LABEL=我的电脑

# 可选：扩展日志文件（默认 ~/.pi/agent/pi-remote-sync.log，超 5MB 轮转一份 .old）。
# 日志不再打到终端：会弄乱 pi 的 TUI，rpc/json 模式下还会破坏 stdout 协议流。
# PI_REMOTE_LOG=
# 设为 1 时日志同时写到 stderr（排障用）
# PI_REMOTE_DEBUG=1
# 设为 1 允许观看端执行远程 bash（!命令）
# PI_REMOTE_ALLOW_BASH=1

# 账户。本期固定 admin；不写或留空时，扩展和 attach 都按 admin 处理
PI_REMOTE_ACCOUNT=admin

# 本机设备编号（uuid）。首次运行 attach --init 生成（Windows：node deploy\attach.cjs --init；
# macOS / Linux：deploy/attach.sh --init），生成后不要改；重装系统才换。每台电脑各有一个，不要从别的电脑抄过来
PI_REMOTE_DEVICE_ID=

# 设备显示名（网页上的设备列表）。留空按平台：Windows / Mac / Linux。
# 新装的 macOS 跑 deploy/attach.sh --init 时会写成这台电脑的电脑名，名册里不会两台都叫 "Mac"。
PI_REMOTE_DEVICE_NAME=

# 允许网页新建/启用会话的目录，分号分隔。harness_start 只能启动这里列出的目录。
# 例：Windows  D:\pi-myself;D:\work\app      macOS  /Users/me/work/app;/Users/me/notes
# 留空时 node deploy/setup.cjs 会填成本项目目录
PI_REMOTE_PROJECTS=

# 仅 macOS / Linux：网页"新建/启用会话"时 pi 怎么拉起。
#   terminal  macOS 缺省：开一个 Terminal 新窗口（电脑要处于登录状态，窗口开在桌面上）
#   tmux      后台 tmux 会话，Linux 只支持这个；之后 tmux ls / tmux attach -t <会话名> 接管
# PI_REMOTE_LAUNCHER=terminal
# macOS 用别的终端时填应用名，例如 iTerm（缺省 Terminal）
# PI_REMOTE_TERMINAL_APP=Terminal
# 找不到 pi 时填它的绝对路径（缺省先找 PATH，再试 nvm、/opt/homebrew/bin、/usr/local/bin）
# PI_REMOTE_PI_BIN=
# macOS / Linux：attach 窗口开着时防止空闲睡眠（macOS caffeinate；Linux systemd-inhibit；屏幕照常熄灭，合盖照常睡）。缺省开，设 0 关掉
# PI_REMOTE_KEEP_AWAKE=1
# 拉起后等会话上线的时间（毫秒）。macOS Terminal 缺省 4000，Windows 新控制台缺省 6000；
# macOS 超时只算"没确认"，不会删脚本或清占用；设 0 关掉等待
# PI_REMOTE_LAUNCH_WAIT_MS=4000

# ---- P9：设备级删除（B）与按设备选文件夹（C）----
# 允许网页浏览并选择的根目录，分号分隔。「打开文件夹…」只能看这些根目录里面的目录，
# 且白名单（PI_REMOTE_PROJECTS）之外、这些根目录里的文件夹也能从网页新建会话（attach 按真实路径复查）。
# 留空 = 只允许浏览家目录（缺省）；off / 0 / false = 关闭浏览（网页上按钮置灰）。
# 最多 8 个；不存在 / 不是目录的项会被忽略。
# PI_REMOTE_BROWSE_ROOTS=
# 反向同步扫描本机会话目录的间隔（毫秒）。在电脑上用 pi 的 /resume 按 Ctrl+D 删除、或直接删掉
# 会话文件后，网页和服务器最多等这么久就会跟上。缺省 30000，最小 5000。
# PI_REMOTE_LIBRARY_RESCAN_MS=30000
